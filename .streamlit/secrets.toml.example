# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud → Settings → Secrets.

# Editors: emails allowed to add / edit / close / cancel ad-hocs and edit the
# equipment config. Everyone on the Cloud viewer allow-list can VIEW.
editors = ["you@example.com"]

# Local development only: identity used when st.user.email is unavailable.
dev_actor = "dev@local"

# Store selection: "github" (default when a token is present) or "local".
# REMIT2_STORE env var overrides this.
store = "local"

[github]            # the separate private DATA repo (never the app repo)
owner = "your-github-owner"
repo = "remit2-data"
branch = "main"
token = "github_pat_..."   # fine-grained PAT: this repo only, Contents read/write
